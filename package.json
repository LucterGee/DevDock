{
  "name": "devdock",
  "version": "2.0.6",
  "description": "",
  "main": "main.js",
  "author": "LucterGee",
  "repository": {
    "type": "git",
    "url": "https://github.com/LucterGee/DevDock.git"
  },
  "scripts": {
    "server": "cd server && node index.js",
    "client": "cd client && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\" --names \"SERVER,CLIENT\" -c \"bgBlue.bold,bgGreen.bold\"",
    "start": "electron .",
    "weekly-report:mcp": "node packages/weekly-report-mcp/index.js",
    "startmenu": "electron . -- --show-menu",
    "nginx:fetch": "node scripts/fetch-nginx.js",
    "pack": "node scripts/build-electron.js --dir",
    "dist": "node scripts/build-electron.js"
  },
  "build": {
    "appId": "com.luctergee.devdock",
    "productName": "DevDock",
    "directories": {
      "output": "dist_electron"
    },
    "win": {
      "target": "nsis",
      "icon": "client/dist/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "client/dist/mac.png",
      "category": "public.app-category.developer-tools"
    },
    "dmg": {
      "title": "DevDock Installer"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "LucterGee",
        "repo": "DevDock"
      }
    ],
    "extraResources": [
      {
        "from": "resources/nginx",
        "to": "nginx",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "main.js",
      "server/**/*",
      "client/dist/**/*",
      "package.json",
      "!server/node_modules"
    ],
    "asar": true
  },
  "keywords": [],
  "license": "MIT",
  "type": "commonjs",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "cpu-features",
      "ssh2"
    ]
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.11.16",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "electron-updater": "^6.8.3",
    "express": "^5.2.1",
    "fix-path": "3.0.0",
    "pidtree": "^0.6.0",
    "pidusage": "^4.0.1",
    "semver": "^7.7.4",
    "socket.io": "^4.8.3"
  }
}
